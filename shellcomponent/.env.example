# Optional dev-only (Vite). Copy to .env.local — never commit secrets.
# Device pre-seed (same shape as ~/.keeper/config.json); username must match `login`.
# VITE_KEEPER_DEV_DEVICE_USER=you@example.com
# VITE_KEEPER_DEV_DEVICE_TOKEN=
# VITE_KEEPER_DEV_DEVICE_PRIVATE_KEY=

# VITE_KEEPER_HOST=keepersecurity.eu
# VITE_KEEPER_USERNAME=
# VITE_KEEPER_SESSION_TOKEN=
# VITE_REGISTER_DEVICE_TOKEN=
# VITE_REGISTER_DEVICE_PRIVATE_KEY=
# VITE_RESTORE_SESSION_JSON=
